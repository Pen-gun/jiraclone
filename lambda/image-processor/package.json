{
  "name": "image-processor",
  "version": "1.0.0",
  "description": "AWS Lambda function to process uploaded images",
  "main": "index.mjs",
  "type": "module",
  "scripts": {
    "build": "npm install && zip -r function.zip .",
    "deploy": "aws lambda update-function-code --function-name image-processor --zip-file fileb://function.zip"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "sharp": "^0.33.4"
  }
}
